NODE_ENV=development
PORT=3010
WEB_PORT=8080
MODBUS_SIM_PORT=1502

APP_URL=http://localhost:3010
FRONTEND_URL=http://localhost:5173
API_VERSION=v1

DATABASE_PATH=./data/tele-pendant.sqlite
DATABASE_SYNC=true
DATABASE_AUTOLOAD=true
SQLITE_DIR=./data

JWT_SECRET=change-me-tele-pendant-jwt-secret-min-32-chars
JWT_TOKEN_AUDIENCE=tele-pendant
JWT_TOKEN_ISSUER=tele-pendant-api
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400
COOKIE_SECURE=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
SAFE_ACTION_PIN=change-me-admin-password

# Local (host): 127.0.0.1 — Docker Compose overrides to modbus-sim
MODBUS_HOST=127.0.0.1
MODBUS_PORT=1502
MODBUS_UNIT_ID=1

# Optional plant camera (demo uses device camera when unset)
# CAMERA_RTSP_URL=rtsp://camera.local/stream

# Production image overrides (deploy.sh / docker-compose.prod.yml)
# TELE_PENDANT_API_IMAGE=ghcr.io/your-org/tele-pendant-api:latest
# TELE_PENDANT_SIM_IMAGE=ghcr.io/your-org/tele-pendant-sim:latest
# TELE_PENDANT_WEB_IMAGE=ghcr.io/your-org/tele-pendant-web:latest
