NODE_ENV=development
# Host publish ports (what nginx on the VPS proxies to).
# API container always listens on 3010 internally; PORT is only the host mapping.
# Web container listens on 80 internally; WEB_PORT is the host mapping.
PORT=3010
WEB_PORT=8080
MODBUS_SIM_PORT=1502

# Public origins the browser / phone use.
# Local:
APP_URL=http://localhost:3010
FRONTEND_URL=http://localhost:5173
# Production (set these to your hosts; the build has no default host):
# APP_URL=https://api.example.com
# FRONTEND_URL=https://hmi.example.com
# TP-44 CORS: FRONTEND_URL is allowlisted; localhost/127.0.0.1 allowed in development only.
# CORS_EXTRA_ORIGINS=
# Expo on a physical phone (same Wi‑Fi as Docker) — overrides apps/mobile/.env production URL:
# MOBILE_API_URL=http://192.168.1.10:3010/api/v1
# Mobile Expo also reads EXPO_PUBLIC_API_URL in apps/mobile/.env via app.config.js:
# EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
# OTA_PUBLIC_URL=https://api.example.com
# COOKIE_SECURE=true
# Optional Swagger “Live” server URL (defaults to APP_URL):
# SWAGGER_LIVE_URL=https://api.example.com
# Cursor assistant (optional — leave empty for FTS-only; not required for acceptance):
# CURSOR_API_KEY=
# CURSOR_AGENT_CWD=
# CURSOR_MODEL=composer-2.5
# Face template encryption (AES-256-GCM). Required in production for sealed templates.
FACE_TEMPLATE_KEY=change-me-face-template-key-min-32-chars
API_VERSION=v1

DATABASE_PATH=./data/tele-pendant.sqlite
DATABASE_SYNC=false
# Face enroll and face login stay off unless this is true.
FACE_LOGIN_ENABLED=false
DATABASE_AUTOLOAD=true
SQLITE_DIR=./data

JWT_SECRET=change-me-tele-pendant-jwt-secret-min-32-chars
JWT_TOKEN_AUDIENCE=tele-pendant
JWT_TOKEN_ISSUER=tele-pendant-api
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400
# true when APP_URL / FRONTEND_URL are https
COOKIE_SECURE=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
SAFE_ACTION_PIN=change-me-admin-password

# Optional Zoho (or other) SMTP for per-user email OTP 2FA. Leave empty to keep 2FA unavailable.
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Tele-Pendant <noreply@tele-pendant.com>

# Local (host): 127.0.0.1 — Docker Compose overrides to modbus-sim
MODBUS_HOST=127.0.0.1
MODBUS_PORT=1502
MODBUS_UNIT_ID=1

# Optional plant camera (demo uses device camera when unset)
# CAMERA_RTSP_URL=rtsp://camera.local/stream

# Production deploy (./deploy.sh pull-from-GHCR mode)
# PAT needs read:packages. Username is your GitHub login (lowercase for image owner).
# GHCR_USERNAME=<github user>
# GHCR_PULL_TOKEN=ghp_...
# Required. deploy.sh stops if any of these is empty:
# TELE_PENDANT_API_IMAGE=ghcr.io/<owner>/tele-pendant-api:latest
# TELE_PENDANT_SIM_IMAGE=ghcr.io/<owner>/tele-pendant-sim:latest
# TELE_PENDANT_WEB_IMAGE=ghcr.io/<owner>/tele-pendant-web:latest
# Local build on the server instead of pulling: DEPLOY_BUILD_LOCAL=1 ./deploy.sh
