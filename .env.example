NODE_ENV=development
# Host publish ports (what nginx on the VPS proxies to).
# API container always listens on 3010 internally; PORT is only the host mapping.
# Web container listens on 80 internally; WEB_PORT is the host mapping.
PORT=3010
WEB_PORT=8080
MODBUS_SIM_PORT=1502

# Public origins the browser / phone use.
# Local:
APP_URL=http://localhost:3010
FRONTEND_URL=http://localhost:5173
# Production (live):
# APP_URL=https://api.tele-pendant.jahbyte.com
# FRONTEND_URL=https://tele-pendant.jahbyte.com
# Expo on a physical phone (same Wi‑Fi as Docker) — overrides apps/mobile/.env production URL:
# MOBILE_API_URL=http://192.168.1.10:3010/api/v1
# Mobile Expo also reads EXPO_PUBLIC_API_URL in apps/mobile/.env via app.config.js:
# EXPO_PUBLIC_API_URL=https://api.tele-pendant.jahbyte.com/api/v1
# COOKIE_SECURE=true
# Swagger: https://api.tele-pendant.jahbyte.com/api
# Health:  https://api.tele-pendant.jahbyte.com/api/v1/health
# Web:     https://tele-pendant.jahbyte.com
# Optional Swagger “Live” server URL (defaults to api.tele-pendant.jahbyte.com):
# SWAGGER_LIVE_URL=https://api.tele-pendant.jahbyte.com
# Cursor assistant (optional — leave empty for FTS-only; not required for acceptance):
# CURSOR_API_KEY=
# CURSOR_AGENT_CWD=
# CURSOR_MODEL=composer-2.5
# Face template encryption (AES-256-GCM). Required in production for sealed templates.
FACE_TEMPLATE_KEY=change-me-face-template-key-min-32-chars
API_VERSION=v1

DATABASE_PATH=./data/tele-pendant.sqlite
DATABASE_SYNC=true
DATABASE_AUTOLOAD=true
SQLITE_DIR=./data

JWT_SECRET=change-me-tele-pendant-jwt-secret-min-32-chars
JWT_TOKEN_AUDIENCE=tele-pendant
JWT_TOKEN_ISSUER=tele-pendant-api
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400
# true when APP_URL / FRONTEND_URL are https
COOKIE_SECURE=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
SAFE_ACTION_PIN=change-me-admin-password

# Local (host): 127.0.0.1 — Docker Compose overrides to modbus-sim
MODBUS_HOST=127.0.0.1
MODBUS_PORT=1502
MODBUS_UNIT_ID=1

# Optional plant camera (demo uses device camera when unset)
# CAMERA_RTSP_URL=rtsp://camera.local/stream

# Production image overrides (deploy.sh / docker-compose.prod.yml)
# TELE_PENDANT_API_IMAGE=ghcr.io/your-org/tele-pendant-api:latest
# TELE_PENDANT_SIM_IMAGE=ghcr.io/your-org/tele-pendant-sim:latest
# TELE_PENDANT_WEB_IMAGE=ghcr.io/your-org/tele-pendant-web:latest
