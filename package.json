{
  "name": "tele-pendant",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "verify": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:cov",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:watch": "docker compose -f docker-compose.dev.yml up --build --watch",
    "docker:up": "docker compose up --build -d",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.dev.yml down && docker compose down",
    "handover:mobile:apk": "pnpm --filter @tele-pendant/mobile apk:release",
    "handover:mobile:aab": "pnpm --filter @tele-pendant/mobile aab:release",
    "handover:mobile:ios": "pnpm --filter @tele-pendant/mobile ios:release",
    "handover:mobile:android": "pnpm handover:mobile:apk && pnpm handover:mobile:aab",
    "handover:mobile": "pnpm handover:mobile:android && pnpm handover:mobile:ios",
    "handover:mobile:signing-zip": "pnpm --filter @tele-pendant/mobile signing:zip"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
