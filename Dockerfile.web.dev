# Local development image for Tele-Pendant web (Vite dev server, no host bind mount).
FROM node:26-bookworm-slim

RUN corepack enable && corepack prepare pnpm@12.18.0 --activate

WORKDIR /app

ENV NODE_ENV=development

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc turbo.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

RUN pnpm install

COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

RUN pnpm --filter @tele-pendant/shared build

EXPOSE 5173

CMD ["pnpm", "--filter", "@tele-pendant/web", "exec", "vite", "--host", "0.0.0.0", "--port", "5173"]
