NODE_ENV=development
PORT=3010
# Local:
APP_URL=http://localhost:3010
FRONTEND_URL=http://localhost:5173
# Live: APP_URL=https://api.tele-pendant.jahbyte.com
# Live: FRONTEND_URL=https://tele-pendant.jahbyte.com
# Swagger servers dropdown: Localhost (PORT) + Live
# SWAGGER_LIVE_URL=https://api.tele-pendant.jahbyte.com
API_VERSION=v1

DATABASE_PATH=./data/tele-pendant.sqlite
DATABASE_SYNC=true
DATABASE_AUTOLOAD=true

JWT_SECRET=change-me-tele-pendant-jwt-secret-min-32-chars
JWT_TOKEN_AUDIENCE=tele-pendant
JWT_TOKEN_ISSUER=tele-pendant-api
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400
COOKIE_SECURE=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

MODBUS_HOST=127.0.0.1
MODBUS_PORT=1502
MODBUS_UNIT_ID=1

SAFE_ACTION_PIN=change-me-admin-password

# Optional plant camera (demo uses device camera when unset)
# CAMERA_RTSP_URL=rtsp://camera.local/stream

