{
  "name": "@tele-pendant/api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest --watchman=false --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --watchman=false --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --watchman=false --runInBand",
    "verify": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:cov",
    "docs": "compodoc -c .compodocrc.json",
    "docs:serve": "compodoc -c .compodocrc.json -s -o -w --port 8081",
    "docs:coverage": "compodoc -c .compodocrc.json --coverageTest 70",
    "http:health": "httpyac send src/app.endpoints.http --all",
    "docker:dev": "docker compose -f ../../docker-compose.dev.yml up --build api modbus-sim",
    "docker:prod": "docker compose -f ../../docker-compose.prod.yml up -d --build",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/database/data-source.js",
    "migration:show": "typeorm migration:show -d dist/database/data-source.js"
  },
  "dependencies": {
    "@cursor/sdk": "^1.3.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.8",
    "@tele-pendant/modbus-core": "workspace:*",
    "@tele-pendant/plc-driver": "workspace:*",
    "@tele-pendant/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jpeg-js": "^0.4.4",
    "nodemailer": "^10.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^1.1.26",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "httpyac": "^6.16.6",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "app.service.ts",
      "app.controller.ts",
      "common/interceptors/data-response/data-response.interceptor.ts",
      "auth/providers/auth.service.ts",
      "users/providers/safe-action-pin.service.ts",
      "audit/providers/audit.service.ts",
      "safety/providers/safety-state.service.ts",
      "hmi/providers/hmi.service.ts",
      "alarms/providers/alarm-engine.service.ts",
      "media/providers/media.service.ts",
      "media/providers/voice-match.ts",
      "auth/providers/face.util.ts",
      "assistant/providers/assistant.service.ts",
      "ota/ota-code-signing.ts",
      "common/cors-origins.ts",
      "!**/*.module.ts",
      "!**/*.spec.ts",
      "!**/dtos/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  }
}
