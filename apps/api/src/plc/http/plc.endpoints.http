@baseUrl = http://localhost:3010
@apiVersion = v1
@accessToken =

### PLC health
# @name plcHealth
GET {{baseUrl}}/api/{{apiVersion}}/plc/health
Authorization: Bearer {{accessToken}}

### List connections
# @name plcConnections
GET {{baseUrl}}/api/{{apiVersion}}/plc/connections
Authorization: Bearer {{accessToken}}

### Read hoist height (holding 0)
# @name readHeight
GET {{baseUrl}}/api/{{apiVersion}}/plc/holding/0
Authorization: Bearer {{accessToken}}

### Write deadman coil ON (admin maintenance only — TP-36)
# @name deadmanOn
POST {{baseUrl}}/api/{{apiVersion}}/plc/coil
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "address": 10,
  "value": true
}

### Write holding (admin maintenance only — TP-36)
# @name writeHolding
POST {{baseUrl}}/api/{{apiVersion}}/plc/holding
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "address": 0,
  "value": 100
}
