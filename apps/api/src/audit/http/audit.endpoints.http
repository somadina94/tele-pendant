@baseUrl = http://localhost:3010
@apiVersion = v1
@accessToken =

### List audit logs (paginated, filterable)
# @name auditList
GET {{baseUrl}}/api/{{apiVersion}}/audit?page=1&pageSize=25&from=2026-01-01&to=2026-01-31&user=admin
Authorization: Bearer {{accessToken}}

### Export audit logs as CSV (same filters, no pagination)
# @name auditExport
GET {{baseUrl}}/api/{{apiVersion}}/audit/export?from=2026-01-01&to=2026-01-31
Authorization: Bearer {{accessToken}}
