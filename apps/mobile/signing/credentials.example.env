# Copy to credentials.env (gitignored). Paths relative to apps/mobile/signing/ unless absolute.

TELE_PENDANT_ANDROID_KEYSTORE=android/tele-pendant-release.keystore
TELE_PENDANT_ANDROID_KEYSTORE_PASSWORD=
TELE_PENDANT_ANDROID_KEY_ALIAS=tele-pendant
TELE_PENDANT_ANDROID_KEY_PASSWORD=

# Expo Updates OTA code signing (TP-43). Private key only — never commit.
# OTA_CODE_SIGNING_PRIVATE_KEY_PATH=ota/private-key.pem
# Or paste PEM (use \n for newlines) as OTA_CODE_SIGNING_PRIVATE_KEY on the API host.

APPLE_TEAM_ID=
IOS_SCHEME=TelePendant
IOS_EXPORT_METHOD=ad-hoc
IOS_PROVISIONING_PROFILE_NAME=
