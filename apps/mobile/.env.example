# Mobile / Expo — copy to .env locally (gitignored).
# Required. The phone build fails when these are missing.
# For a phone on the same Wi-Fi as Docker, set MOBILE_API_URL in the repo root .env instead.
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
OTA_PUBLIC_URL=https://api.example.com
# Face login stays hidden unless this is true.
EXPO_PUBLIC_FACE_LOGIN=false
