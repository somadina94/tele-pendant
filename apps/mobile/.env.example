# Mobile / Expo — copied to .env locally (gitignored)
# For local Docker + phone: set MOBILE_API_URL in repo root .env instead (see root .env.example).
EXPO_PUBLIC_API_URL=https://YOUR_API_HOST/api/v1
OTA_PUBLIC_URL=https://YOUR_API_HOST
# Leave unset for an https API. A factory API on http:// is allowed unless this is false.
# EXPO_PUBLIC_ALLOW_HTTP=true
EXPO_PUBLIC_FACE_LOGIN=false
