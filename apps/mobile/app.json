{
  "expo": {
    "name": "Tele-Pendant",
    "slug": "tele-pendant",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "telependant",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.telependant.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07090c"
      },
      "package": "com.telependant.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#07090c",
      "themeColor": "#07090c"
    },
    "plugins": [
      "expo-camera",
      "expo-speech-recognition"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "http://localhost:3010/ota/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "otaNote": "Production updates.url: https://api.tele-pendant.jahbyte.com/ota/manifest. Local lab: http://<lan-host>:3010/ota/manifest. The API serves apps/api/ota with no login. Native modules (camera, speech) still need a binary rebuild; JS-only changes are what that folder ships."
    }
  }
}
