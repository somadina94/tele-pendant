{
  "expo": {
    "name": "Tele-Pendant",
    "slug": "tele-pendant",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "telependant",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.telependant.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1419"
      },
      "package": "com.telependant.app"
    },
    "plugins": ["expo-camera", "expo-speech-recognition"],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "http://localhost:3010/ota/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "otaNote": "Point updates.url at http://<api-host>:3010/ota/manifest. The API serves apps/api/ota with no login. Native modules (camera) still need a binary rebuild; JS-only changes are what that folder ships."
    }
  }
}
