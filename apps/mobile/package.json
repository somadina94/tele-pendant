{
  "name": "@tele-pendant/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "NODE_ENV=development expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "echo \"expo export handled in CI/OTA step\"",
    "ota:export": "node scripts/export-ota.mjs",
    "apk:release": "node scripts/build-apk-release.mjs",
    "aab:release": "node scripts/build-aab-release.mjs",
    "ios:release": "node scripts/build-ios-release.mjs",
    "signing:zip": "node scripts/package-signing-zip.mjs",
    "format": "prettier --write \"App.tsx\" \"index.js\" \"babel.config.js\" \"src/**/*.{ts,tsx}\"",
    "lint": "echo \"lint mobile deferred until eslint-config wired\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --watchman=false --passWithNoTests",
    "test:cov": "jest --watchman=false --coverage --passWithNoTests"
  },
  "dependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/runtime": "^7.29.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.5.1",
    "@tanstack/react-query": "^5.107.1",
    "@tele-pendant/shared": "workspace:*",
    "expo": "~58.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "^58.0.15",
    "expo-haptics": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-speech-recognition": "^58.0.1",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "^58.0.21",
    "lucide-react-native": "^1.70.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-drawer-layout": "^4.2.12",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "testRegex": ".*\\.spec\\.(ts|tsx)$",
    "testEnvironment": "node",
    "coverageDirectory": "coverage"
  }
}
