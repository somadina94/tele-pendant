{
  "name": "@tele-pendant/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "echo \"expo export handled in CI/OTA step\"",
    "format": "prettier --write \"App.tsx\" \"index.js\" \"babel.config.js\" \"src/**/*.{ts,tsx}\"",
    "lint": "echo \"lint mobile deferred until eslint-config wired\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --watchman=false --passWithNoTests",
    "test:cov": "jest --watchman=false --coverage --passWithNoTests"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@tanstack/react-query": "^5.66.0",
    "@tele-pendant/shared": "workspace:*",
    "expo": "~52.0.0",
    "expo-camera": "~16.0.18",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "^58.0.20",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~18.3.12",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "testRegex": ".*\\.spec\\.(ts|tsx)$",
    "testEnvironment": "node",
    "coverageDirectory": "coverage"
  }
}
