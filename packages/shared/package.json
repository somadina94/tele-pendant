{
  "name": "@tele-pendant/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/i18n && cp i18n/*.json dist/i18n/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "echo \"lint shared skipped\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
