{
  "name": "@tele-pendant/modbus-core",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "echo \"lint modbus-core skipped\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests --testPathIgnorePatterns=integration",
    "test:cov": "jest --coverage --passWithNoTests --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPatterns=integration --runInBand"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "memory-driver.ts",
      "tcp-driver.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "dependencies": {
    "jsmodbus": "^5.0.0"
  }
}
