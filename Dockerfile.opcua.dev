# Optional OPC UA crane simulator. Not started by docker:dev.
FROM node:22-bookworm-slim

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/opcua-sim/package.json ./apps/opcua-sim/

RUN pnpm install

COPY apps/opcua-sim ./apps/opcua-sim

ENV OPCUA_PORT=4840
EXPOSE 4840

CMD ["pnpm", "--filter", "@tele-pendant/opcua-sim", "dev"]
